ADINTEL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adintel
ADINTEL_CONFIG_FILE=config/advertisers.yaml
ADINTEL_STATE_DIR=state
ADINTEL_CDP_URL=http://127.0.0.1:9222
ADINTEL_BROWSER_CHANNEL=chromium

# Alerting (optional — leave blank to disable webhook notifications)
# ADINTEL_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ADINTEL_ALERT_ON_FAILURE=true
# ADINTEL_ALERT_ON_STALENESS=true
# ADINTEL_STALE_WARNING_HOURS=48
# ADINTEL_STALE_CRITICAL_HOURS=168
# ADINTEL_MAX_CONSECUTIVE_FAILURES=3
