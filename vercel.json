{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/api/mcp", "dest": "api/index.py" },
    { "src": "/api/mcp/", "dest": "api/index.py" },
    { "src": "/api/mcp/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "ADINTEL_AUTO_APPLY_SCHEMA": "false"
  }
}
